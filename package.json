{
  "name": "personal-notebook-tool",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Personal notebook tool: Markdown notes with live preview, visual tables, attachments, tags and full-text search.",
  "author": {
    "name": "Jesus Adrian Alcocer Donez",
    "email": "jesus.adrian.01@hotmail.com"
  },
  "homepage": "https://example.com",
  "main": "apps/main/dist/index.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "rebuild:electron": "rimraf node_modules/better-sqlite3/build && electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "rimraf node_modules/better-sqlite3/build && npm rebuild better-sqlite3",
    "postinstall": "npm run rebuild:electron",
    "predev": "npm run rebuild:electron",
    "dev": "electron-vite dev",
    "prebuild": "npm run rebuild:electron",
    "build": "electron-vite build",
    "prebuild:app": "npm run rebuild:electron",
    "build:app": "electron-vite build && electron-builder",
    "lint": "eslint .",
    "pretest": "npm run rebuild:node",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "eslint": "^9.14.0",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "electron-builder": "^25.1.8",
    "@electron/rebuild": "^3.7.1",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^3.4.14",
    "postcss": "^8.4.47",
    "autoprefixer": "^10.4.20",
    "@types/node": "^22.9.0",
    "vite-plugin-static-copy": "^2.1.0",
    "rimraf": "^6.0.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.notebook.personalnotebook",
    "productName": "Personal Notebook",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "apps/main/dist/**/*",
      "apps/preload/dist/**/*",
      "apps/renderer/dist/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "linux": {
      "target": ["deb"],
      "icon": "build/icon.png",
      "category": "Office",
      "synopsis": "Notas Markdown con vista previa, tablas, adjuntos y búsqueda."
    }
  }
}
